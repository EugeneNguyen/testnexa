# Copy to `.env` at the worktree root and adjust as needed.
# docker compose automatically loads `.env` from the project root.

# ---------------------------------------------------------------------------
# Compose profile selection (ADR-0010): one docker-compose.yml, two profiles.
#   dev  -> Vite dev server + hot reload, single external port
#   prod -> static frontend build served by nginx, single external port
# ---------------------------------------------------------------------------
COMPOSE_PROFILES=dev

# ---------------------------------------------------------------------------
# Postgres credentials, shared by the `postgres` and `postgres-test` services.
# Override in production deployments.
# ---------------------------------------------------------------------------
POSTGRES_PASSWORD=testnexa_dev_password

# ---------------------------------------------------------------------------
# Backend
# ---------------------------------------------------------------------------
ENV=dev
# JWT signing secret (ADR-0003). Placeholder only — generate and set a real
# secret before any production deployment.
JWT_SECRET=change-me-in-production
